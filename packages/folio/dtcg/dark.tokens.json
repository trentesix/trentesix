{
  "$description": "Folio, Dark: the base and the look, as the CSS declares them. Generated by scripts/build.mjs.",
  "spacing": {
    "space-1": {
      "$description": "Icon to label, avatar overlap step.",
      "$type": "dimension",
      "$value": { "value": 4, "unit": "px" }
    },
    "space-2": {
      "$description": "Chip gaps, button groups.",
      "$type": "dimension",
      "$value": { "value": 8, "unit": "px" }
    },
    "space-3": {
      "$description": "Row padding, field label to input.",
      "$type": "dimension",
      "$value": { "value": 12, "unit": "px" }
    },
    "space-4": {
      "$description": "Card padding, phone gutter.",
      "$type": "dimension",
      "$value": { "value": 16, "unit": "px" }
    },
    "space-5": {
      "$description": "Tile padding, list gaps.",
      "$type": "dimension",
      "$value": { "value": 20, "unit": "px" }
    },
    "space-6": {
      "$description": "Desktop gutter, between sections in a panel.",
      "$type": "dimension",
      "$value": { "value": 24, "unit": "px" }
    },
    "space-8": {
      "$description": "Main content padding.",
      "$type": "dimension",
      "$value": { "value": 32, "unit": "px" }
    },
    "space-10": {
      "$description": "Between major page regions.",
      "$type": "dimension",
      "$value": { "value": 40, "unit": "px" }
    },
    "space-14": {
      "$description": "Above page titles on wide screens.",
      "$type": "dimension",
      "$value": { "value": 56, "unit": "px" }
    }
  },
  "radius": {
    "radius-s": {
      "$description": "Kbd boxes, link chips, thumbnails in rows.",
      "$type": "dimension",
      "$value": { "value": 4, "unit": "px" }
    },
    "radius-m": {
      "$description": "Inputs, list containers, sub-field rows.",
      "$type": "dimension",
      "$value": { "value": 6, "unit": "px" }
    },
    "radius-l": {
      "$description": "Cards, tiles, panels.",
      "$type": "dimension",
      "$value": { "value": 8, "unit": "px" }
    },
    "radius-xl": {
      "$description": "Dialogs and the command palette.",
      "$type": "dimension",
      "$value": { "value": 12, "unit": "px" }
    },
    "radius-pill": {
      "$description": "Buttons, pills, segmented controls, avatars.",
      "$type": "dimension",
      "$value": { "value": 999, "unit": "px" }
    },
    "radius-button": {
      "$description": "Corner of buttons.",
      "$type": "dimension",
      "$value": { "value": 6, "unit": "px" }
    },
    "radius-badge": {
      "$description": "Corner of badges and pills.",
      "$type": "dimension",
      "$value": { "value": 4, "unit": "px" }
    }
  },
  "border": {
    "border-object": {
      "$description": "Outline of every card, input, button and pill.",
      "$type": "dimension",
      "$value": { "value": 1, "unit": "px" }
    },
    "border-strong": {
      "$description": "Dialogs, palette, selected presence ring.",
      "$type": "dimension",
      "$value": { "value": 1, "unit": "px" }
    },
    "border-field": {
      "$description": "Width of a text input's edge.",
      "$type": "dimension",
      "$value": { "value": 1, "unit": "px" }
    }
  },
  "duration": {
    "duration-snap": {
      "$description": "Presses, hovers, toggles' squish.",
      "$type": "duration",
      "$value": { "value": 100, "unit": "ms" }
    },
    "duration-pop": {
      "$description": "Things you caused appearing: ticks, chips, popovers.",
      "$type": "duration",
      "$value": { "value": 150, "unit": "ms" }
    },
    "duration-glide": {
      "$description": "Panels and drawers sliding, list items moving.",
      "$type": "duration",
      "$value": { "value": 250, "unit": "ms" }
    },
    "duration-drift": {
      "$description": "Things arriving on their own: presence, live updates, page transitions.",
      "$type": "duration",
      "$value": { "value": 400, "unit": "ms" }
    },
    "duration-pen": {
      "$description": "Lines that draw themselves: ticks, underlines, rings, the seal.",
      "$type": "duration",
      "$value": { "value": 420, "unit": "ms" }
    }
  },
  "easing": {
    "ease-spring": {
      "$description": "Snap and pop: a small overshoot. Motion spring: stiffness 400, damping 22.",
      "$type": "cubicBezier",
      "$value": [0.2, 0, 0, 1]
    },
    "ease-glide": {
      "$description": "Glide: fast out, soft landing.",
      "$type": "cubicBezier",
      "$value": [0.2, 0, 0, 1]
    },
    "ease-drift": {
      "$description": "Drift: symmetric, calm.",
      "$type": "cubicBezier",
      "$value": [0.2, 0, 0, 1]
    },
    "ease-shake": {
      "$description": "Error shake only.",
      "$type": "cubicBezier",
      "$value": [0.36, 0.07, 0.19, 0.97]
    },
    "ease-pen": {
      "$description": "Lines that draw themselves: ticks, underlines, rings, the seal.",
      "$type": "cubicBezier",
      "$value": [0.65, 0, 0.35, 1]
    }
  },
  "font": {
    "font-display": {
      "$description": "Display type: page and entry titles, headings.",
      "$type": "fontFamily",
      "$value": ["IBM Plex Sans Variable", "IBM Plex Sans", "Segoe UI", "system-ui", "sans-serif"]
    },
    "font-body": {
      "$description": "Body and UI text.",
      "$type": "fontFamily",
      "$value": ["IBM Plex Sans Variable", "IBM Plex Sans", "Segoe UI", "system-ui", "sans-serif"]
    },
    "font-mono": {
      "$description": "Code, ids, keys and keyboard hints.",
      "$type": "fontFamily",
      "$value": ["IBM Plex Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"]
    },
    "font-celebrate": {
      "$description": "Celebrations only; at most once per session.",
      "$type": "fontFamily",
      "$value": ["IBM Plex Sans Variable", "IBM Plex Sans", "Segoe UI", "system-ui", "sans-serif"]
    },
    "font-empty": {
      "$description": "Empty states.",
      "$type": "fontFamily",
      "$value": ["IBM Plex Sans Variable", "IBM Plex Sans", "Segoe UI", "system-ui", "sans-serif"]
    },
    "font-typewriter": {
      "$description": "Memo-style cards.",
      "$type": "fontFamily",
      "$value": ["Courier Prime", "Courier New", "monospace"]
    }
  },
  "typography": {
    "text-display": {
      "$description": "The one big line on a screen: a greeting, a poster number. A whole font value: write `font: var(--text-display)`, with `letter-spacing: var(--text-display-tracking)`.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.font-body}",
        "fontSize": { "value": 28, "unit": "px" },
        "fontWeight": 600,
        "lineHeight": 1.2,
        "letterSpacing": { "value": -0.28, "unit": "px" }
      }
    },
    "text-page-title": {
      "$description": "Page and entry titles. A whole font value: write `font: var(--text-page-title)`, with `letter-spacing: var(--text-page-title-tracking)`.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.font-body}",
        "fontSize": { "value": 22, "unit": "px" },
        "fontWeight": 600,
        "lineHeight": 1.3,
        "letterSpacing": { "value": 0, "unit": "px" }
      }
    },
    "text-title": {
      "$description": "Panel and dialog titles. A whole font value: write `font: var(--text-title)`, with `letter-spacing: var(--text-title-tracking)`.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.font-body}",
        "fontSize": { "value": 16, "unit": "px" },
        "fontWeight": 600,
        "lineHeight": 1.4,
        "letterSpacing": { "value": 0, "unit": "px" }
      }
    },
    "text-section": {
      "$description": "Card, tile and form-section headings. A whole font value: write `font: var(--text-section)`, with `letter-spacing: var(--text-section-tracking)`.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.font-body}",
        "fontSize": { "value": 16, "unit": "px" },
        "fontWeight": 600,
        "lineHeight": 1.4,
        "letterSpacing": { "value": 0, "unit": "px" }
      }
    },
    "text-item": {
      "$description": "Names in rows and on cards. A whole font value: write `font: var(--text-item)`, with `letter-spacing: var(--text-item-tracking)`.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.font-body}",
        "fontSize": { "value": 14, "unit": "px" },
        "fontWeight": 600,
        "lineHeight": 1.4,
        "letterSpacing": { "value": 0, "unit": "px" }
      }
    },
    "text-voice": {
      "$description": "The app speaking: a gentle note, an empty translation. A whole font value: write `font: var(--text-voice)`, with `letter-spacing: var(--text-voice-tracking)`.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.font-body}",
        "fontSize": { "value": 16, "unit": "px" },
        "fontWeight": 400,
        "lineHeight": 1.65,
        "letterSpacing": { "value": 0, "unit": "px" }
      },
      "$extensions": { "dev.trentesix": { "fontStyle": "italic" } }
