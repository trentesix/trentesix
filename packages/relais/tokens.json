  "motion": {
    "tokens": [
      {
        "name": "pop",
        "spring": {
          "stiffness": 360,
          "damping": 38
        },
        "usage": "Things you caused appearing. Calm and firm: it arrives and stays, with no overshoot."
      },
      {
        "name": "settle",
        "spring": {
          "stiffness": 460,
          "damping": 46
        },
        "usage": "Things landing after a move, and the postmark pressing in. Pressed down, not bounced: no overshoot."
      },
      {
        "name": "pen",
        "duration": "420ms",
        "easing": "cubic-bezier(0.6, 0, 0.3, 1)",
        "usage": "Ink drawing itself: ticks, rules, the postmark's rings and the airmail stripe."
      }
    ]
  },
  "look": {
    "about": "What differs from Discothèque beyond colour. Each entry is a CSS variable without its dashes.",
    "values": {
      "radius-s": "4px",
      "radius-m": "10px",
      "radius-l": "12px",
      "radius-xl": "16px",
      "border-object": "1px",
      "border-strong": "2px",
      "stripe-band": "6px",
      "duration-snap": "100ms",
      "duration-pop": "200ms",
      "duration-glide": "280ms",
      "duration-drift": "460ms",
      "ease-spring": "cubic-bezier(0.25, 0.9, 0.3, 1)",
      "ease-glide": "cubic-bezier(0.2, 0, 0, 1)",
      "ease-drift": "cubic-bezier(0.45, 0, 0.55, 1)",
      "outline": "var(--rule)",
      "outline-control": "var(--ink-line)",
      "outline-field": "var(--ink-line)",
      "outline-field-active": "var(--action)",
      "border-field": "1px",
      "divider": "1px solid var(--rule)",
      "focus-ring": "3px",
      "focus-edge": "var(--paper-raised)",
      "press": "0px",
      "lift": "0px",
      "radius-button": "999px",
      "radius-badge": "999px",
      "label-size": "11px",
      "label-weight": "500",
      "label-tracking": "0.08em",
      "label-case": "uppercase",
      "field-label-size": "13px",
      "field-label-tracking": "0",
      "field-label-case": "none",
      "label-color": "var(--ink-muted)",
      "strong-weight": "600",
      "prose-h2": "var(--text-item)",
      "prose-h2-tracking": "var(--text-item-tracking)",
      "prose-h3": "var(--text-section)",
      "prose-h3-tracking": "var(--text-section-tracking)",
      "mark": "var(--teal-soft)",
      "on-mark": "var(--ink)",
      "fw-heavy": "700",
      "ui-size": "15px",
      "link": "var(--action)",
      "inverse": "var(--chocolate)",
      "on-inverse": "var(--on-chocolate)",
      "on-inverse-accent": "var(--code-keyword)",
      "on-chocolate-accent": "var(--code-keyword)",
      "selected-soft": "var(--teal-soft)",
      "relais-airmail": "repeating-linear-gradient(135deg, var(--mustard) 0 14px, var(--paper) 14px 22px, var(--action) 22px 36px, var(--paper) 36px 44px)",
      "postmark-rest": "0.72"
    }
  },
  "temper": "calm"
}
