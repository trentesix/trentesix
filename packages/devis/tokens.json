  "type": {
    "families": {
      "display": "'Barlow Condensed', 'Arial Narrow', 'Segoe UI', system-ui, sans-serif",
      "body": "'Hanken Grotesk Variable', 'Hanken Grotesk', 'Segoe UI', system-ui, sans-serif",
      "mono": "'Martian Mono Variable', 'Martian Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace",
      "money": "'Instrument Serif', 'Iowan Old Style', Georgia, serif",
      "celebrate": "'Instrument Serif', 'Iowan Old Style', Georgia, serif",
      "empty": "'Barlow Condensed', 'Arial Narrow', system-ui, sans-serif"
    },
    "about": "Only the roles that differ from the base. Barlow Condensed is loaded at 500 to 700, so no heading asks for 800 or 900; sizes follow the app (surveyed 2026-11-12): page titles at 44px, body at its 15px --ui-size.",
    "scale": [
      {
        "name": "display",
        "family": "display",
        "size": "88px",
        "lineHeight": 0.9,
        "weight": 700,
        "tracking": "-0.01em"
      },
      {
        "name": "page-title",
        "family": "display",
        "size": "44px",
        "lineHeight": 1,
        "weight": 700,
        "tracking": "-0.01em"
      },
      {
        "name": "title",
        "family": "display",
        "size": "32px",
        "lineHeight": 1.05,
        "weight": 700
      },
      {
        "name": "body",
        "family": "body",
        "size": "15px",
        "lineHeight": 1.55,
        "weight": 400
      },
      {
        "name": "body-strong",
        "family": "body",
        "size": "15px",
        "lineHeight": 1.55,
        "weight": 600
      }
    ]
  },
  "motion": {
    "tokens": [
      {
        "name": "pop",
        "spring": {
          "stiffness": 420,
          "damping": 30
        },
        "usage": "Things you caused appearing. A firm landing, the barest overshoot."
      },
      {
        "name": "settle",
        "spring": {
          "stiffness": 520,
          "damping": 40
        },
        "usage": "Things landing after a move. Quick, no bounce."
      },
      {
        "name": "pen",
        "duration": "380ms",
        "easing": "cubic-bezier(0.65, 0, 0.35, 1)",
        "usage": "Ink drawing itself: ticks, rules, the seal's ring."
      }
    ]
  },
  "look": {
    "about": "What differs from Discothèque beyond colour. Each entry is a CSS variable without its dashes.",
    "values": {
      "radius-s": "2px",
      "radius-m": "4px",
      "radius-l": "6px",
      "radius-xl": "8px",
      "border-object": "2px",
      "border-strong": "2px",
      "stripe-band": "6px",
      "duration-snap": "100ms",
      "duration-pop": "180ms",
      "duration-glide": "260ms",
      "duration-drift": "420ms",
      "ease-spring": "cubic-bezier(0.2, 1.2, 0.4, 1)",
      "ease-glide": "cubic-bezier(0.2, 0, 0, 1)",
      "ease-drift": "cubic-bezier(0.45, 0, 0.55, 1)",
      "outline": "var(--ink)",
      "outline-control": "var(--ink)",
      "outline-field": "var(--ink-line)",
      "outline-field-active": "var(--ink)",
      "border-field": "2px",
      "divider": "1px solid var(--rule)",
      "focus-ring": "3px",
      "focus-edge": "var(--on-mustard)",
      "press": "0px",
      "lift": "0px",
      "radius-button": "4px",
      "radius-badge": "2px",
      "label-size": "13px",
      "label-weight": "600",
      "label-tracking": "0.08em",
      "label-case": "uppercase",
      "field-label-size": "13px",
      "field-label-tracking": "0.08em",
      "field-label-case": "uppercase",
      "label-color": "var(--ink-muted)",
      "fw-heavy": "700",
      "ui-size": "15px",
      "link": "var(--action)",
      "inverse": "var(--chocolate)",
      "on-inverse": "var(--on-chocolate)",
      "on-inverse-accent": "var(--mustard)",
      "on-chocolate-accent": "var(--mustard)",
      "selected-soft": "var(--mustard-soft)"
    }
  },
  "temper": "calm"
