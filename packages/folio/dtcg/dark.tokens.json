    "text-celebrate": {
      "$description": "Celebrations only; at most once per session. A whole font value: write `font: var(--text-celebrate)`, with `letter-spacing: var(--text-celebrate-tracking)`.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.font-display}",
