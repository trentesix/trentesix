    "./tokens.json": "./tokens.json",
    "./dtcg/light.tokens.json": "./dtcg/light.tokens.json",
    "./dtcg/dark.tokens.json": "./dtcg/dark.tokens.json"
  },
  "dependencies": {
    "@trentesix/core": "workspace:^",
