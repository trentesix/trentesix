        "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.65, "hex": "#000000" },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 16, "unit": "px" },
        "blur": { "value": 40, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    },
    "shadow-drag": {
      "$description": "Anything being dragged.",
      "$type": "shadow",
      "$value": {
        "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.6, "hex": "#000000" },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 12, "unit": "px" },
        "blur": { "value": 24, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    },
    "shadow-highlight": {
      "$description": "A preview or field that just changed (new structure preview, toast).",
