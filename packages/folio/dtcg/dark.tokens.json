        "fontFamily": "{font.font-body}",
        "fontSize": { "value": 16, "unit": "px" },
        "fontWeight": 400,
        "lineHeight": 1.65,
        "letterSpacing": { "value": 0, "unit": "px" }
      }
    },
    "text-body": {
      "$description": "Default UI text and inputs. A whole font value: write `font: var(--text-body)`, with `letter-spacing: var(--text-body-tracking)`.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.font-body}",
        "fontSize": { "value": 14, "unit": "px" },
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": { "value": 0, "unit": "px" }
      }
    },
    "text-body-strong": {
      "$description": "Names and button labels. A whole font value: write `font: var(--text-body-strong)`, with `letter-spacing: var(--text-body-strong-tracking)`.",
      "$type": "typography",
